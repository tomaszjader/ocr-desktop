{
  "name": "ocr-desktop",
  "version": "1.0.4",
  "description": "Lokalny OCR zaznaczonego fragmentu ekranu",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pre-dist": "node scripts/create-icon.cjs",
    "pre-dist:win": "node scripts/create-icon.cjs",
    "pre-dist:mac": "node scripts/create-icon.cjs",
    "dist": "npm run dist:win",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "postdist": "node scripts/copy-portable.cjs",
    "postdist:win": "node scripts/copy-portable.cjs",
    "pack": "electron-builder --dir",
    "pack:mac": "electron-builder --mac --dir",
    "test:e2e": "electron scripts/e2e.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomaszjader/ocr-desktop.git"
  },
  "keywords": [],
  "author": "Tomasz",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/tomaszjader/ocr-desktop/issues"
  },
  "homepage": "https://github.com/tomaszjader/ocr-desktop#readme",
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/pol": "^1.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "pl.tekstzekranu.ocrdesktop",
    "productName": "Tekst z ekranu",
    "icon": "src/assets/icon.png",
    "asar": true,
    "asarUnpack": [
      "src/main/platform/**"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": "portable"
    },
    "mac": {
      "icon": "src/assets/icon.png",
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    },
    "portable": {
    "artifactName": "Tekst-z-ekranu-${version}.exe"
    }
  }
}
